# Copy to .env.local. Never commit actual values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: provision only when adapters are implemented.
SUPABASE_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# No Apple signing keys or P12 are used by AN IPA STORE. Owner signs in LCSign on iPhone.
APP_ORIGIN=http://localhost:3000

# Guest Profile Service / currently DISABLED until real iPhone + SCEP/CMS verification.
# All secrets below go in hosting secret manager only; never commit actual values.
ENROLLMENT_ENABLED=false
ENROLLMENT_WAF_READY=false
ENROLLMENT_PROVIDER_START_URL=
ENROLLMENT_PROVIDER_ISSUER=
ENROLLMENT_PROVIDER_PUBLIC_KEY_B64=
ENROLLMENT_UDID_ENCRYPTION_KEY_B64=
ENROLLMENT_TRUSTED_IP_HEADER=

# Manual UDID: never enable before trusted WAF, data privacy + retention setup.
MANUAL_UDID_ENABLED=false
MANUAL_UDID_WAF_READY=false

# Retention cleanup is not scheduled automatically. Configure secure external
# scheduler with POST /api/internal/retention and Bearer MAINTENANCE_CRON_SECRET.
MAINTENANCE_ENABLED=false
MAINTENANCE_CRON_SECRET=

# Admin login only; enabled after HTTPS / WAF and a real admin account with
# server-granted roles.role = 'admin'. Requires unique 32-byte base64 secret.
# Session is encrypted in Secure HttpOnly host cookie, expires after 45 minutes.
ADMIN_AUTH_ENABLED=false
ADMIN_AUTH_WAF_READY=false
ADMIN_SESSION_KEY_B64=

# Private Cloudflare R2 signed upload pilot. ALL flags must remain false until
# Admin Auth + trusted WAF + bucket lifecycle + ingestion scanner are tested.
R2_PRIVATE_UPLOAD_ENABLED=false
R2_PRIVATE_WAF_READY=false
R2_QUARANTINE_LIFECYCLE_READY=false
R2_SCANNER_READY=false

# Read-only server-side HeadBucket probe (Admin only, Preview only)
R2_STORAGE_DIAGNOSTICS_ENABLED=false

# Separate Preview-only synthetic write/head/delete diagnostic; default OFF
R2_WRITE_DIAGNOSTICS_ENABLED=false

# Preview Admin-only cross-origin synthetic browser upload test (default OFF)
R2_BROWSER_DIAGNOSTICS_ENABLED=false

# Separate isolated worker environment, never NEXT_PUBLIC or GitHub.
IPA_QUARANTINE_WORKER_ENABLED=false
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=server-only sb_secret key
# R2_ACCOUNT_ID, R2_BUCKET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY

# Vercel Workflow + ephemeral Sandbox. Preview only until release gates pass.
IPA_VERCEL_WORKER_ENABLED=false
# SUPABASE_SECRET_KEY is needed on the server; never forwarded into the Sandbox.
# No Vercel token required in deployment: Sandbox uses project OIDC.

# OTA install grants. The persistent grant issuer and the public manifest /
# download endpoints now exist (src/modules/ota, /api/ota/*) but sit behind
# this dual gate. Keep BOTH false until trusted Apple verification has run
# on a real Mac, real IPA/device evidence exists, the install_grants /
# verifier_attestations migration is applied to the real project, and a
# physical iPhone OTA test passes. Setting one flag alone never enables OTA.
# APP_ORIGIN (above) must be the store's public HTTPS origin: grant links,
# the manifest and the download redirect are all bound to that single host.
OTA_INSTALL_ENABLED=false
OTA_INSTALL_PIPELINE_READY=false
