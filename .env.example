# Copy to .env.local. Never commit actual values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: provision only when adapters are implemented.
SUPABASE_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# No Apple signing keys or P12 are used by AN IPA STORE. Owner signs in LCSign on iPhone.
APP_ORIGIN=http://localhost:3000

# Guest Profile Service / currently DISABLED until real iPhone + SCEP/CMS verification.
# All secrets below go in hosting secret manager only; never commit actual values.
ENROLLMENT_ENABLED=false
ENROLLMENT_WAF_READY=false
ENROLLMENT_PROVIDER_START_URL=
ENROLLMENT_PROVIDER_ISSUER=
ENROLLMENT_PROVIDER_PUBLIC_KEY_B64=
ENROLLMENT_UDID_ENCRYPTION_KEY_B64=
ENROLLMENT_TRUSTED_IP_HEADER=

# Manual UDID: never enable before trusted WAF, data privacy + retention setup.
MANUAL_UDID_ENABLED=false
MANUAL_UDID_WAF_READY=false

# Retention cleanup is not scheduled automatically. Configure secure external
# scheduler with POST /api/internal/retention and Bearer MAINTENANCE_CRON_SECRET.
MAINTENANCE_ENABLED=false
MAINTENANCE_CRON_SECRET=

# Admin login only; enabled after HTTPS / WAF and a real admin account with
# server-granted roles.role = 'admin'. Requires unique 32-byte base64 secret.
# Session is encrypted in Secure HttpOnly host cookie, expires after 45 minutes.
ADMIN_AUTH_ENABLED=false
ADMIN_AUTH_WAF_READY=false
ADMIN_SESSION_KEY_B64=
